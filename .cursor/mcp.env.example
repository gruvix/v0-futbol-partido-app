# PostgreSQL MCP credentials (project-local secrets)
# Export these vars (or copy to .cursor/mcp.env and source it) before starting Cursor.
# Use separate DB users — readonly vs read-write.
#
# Neon: set PG_SSL=true (required for SSL)

PG_SSL=true

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=futbol_partido

PG_READONLY_USER=readonly_user
PG_READONLY_PASSWORD=CHANGE_ME_READONLY

PG_WRITE_USER=write_user
PG_WRITE_PASSWORD=CHANGE_ME_WRITE
